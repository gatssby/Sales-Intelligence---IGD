# Local dashboard connects through an SSH tunnel to the VPS database.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5433/sales_intelligence
DATABASE_SSL=disable

# Optional future API-backed analysis. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Vercel AI Gateway. The controlled queue worker is disabled unless --apply is explicit.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# Optional AI SDK Gateway provider endpoint override. Usually leave unset.
AI_GATEWAY_PROVIDER_BASE_URL=
AI_GATEWAY_TIMEOUT_MS=300000
AI_GATEWAY_PRIMARY_MODEL=openai/gpt-5.6-luna
AI_GATEWAY_ESCALATION_MODEL=openai/gpt-5.6-sol
AI_ANALYSIS_CONFIDENCE_THRESHOLD=0.5
AI_ANALYSIS_STRATEGY_VERSION=insider-cost-quality-v1
AI_ANALYSIS_MAX_TECHNICAL_RETRIES=1
AI_ANALYSIS_LEASE_SECONDS=420
AI_ANALYSIS_RETRY_DELAY_SECONDS=60
AI_ANALYSIS_MAX_OUTPUT_TOKENS=5000
AI_BUDGET_ACCOUNT_ID=sales-intelligence-igd
AI_BUDGET_LIMIT_USD=15
AI_BUDGET_SAFETY_RESERVE_USD=0.10
AI_BUDGET_RECONCILIATION_INTERVAL_MS=60000
AI_BUDGET_LIVE_SPEND_LAG_BUFFER_USD=0
# Capture the aggregate spend floor immediately before enabling paid processing.
AI_BUDGET_EXTERNAL_SPEND_BASELINE_USD=
AI_BUDGET_PRIMARY_RESERVATION_USD=0.03
AI_BUDGET_ESCALATION_RESERVATION_USD=0.20
# Optional management credentials for periodic read-only reconciliation.
VERCEL_AI_GATEWAY_KEY_ID=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
AI_BENCHMARK_CONCURRENCY=3
BENCHMARK_MAX_COST_USD=4
# Optional historical benchmark metadata only.
VERCEL_KEY_SPEND_SANITY_CHECK_USD=0
AI_PROVIDER=vercel-ai-gateway
RUBRIC_VERSION=insider-production-v1
PROMPT_VERSION=call-analysis-v1
SCHEMA_VERSION=analysis-output-v1

# OAuth credentials for read-only Google Drive transcript access. The worker
# exchanges the refresh token for an access token held only in process memory.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
TRANSCRIPT_MAX_ATTEMPTS=3
TRANSCRIPT_RETRY_DELAY_SECONDS=3600

# Autonomous Drive discovery. Cataloging is enabled independently from paid analysis.
DRIVE_DISCOVERY_INTERVAL_MS=300000
DRIVE_DISCOVERY_FULL_SCAN_INTERVAL_MS=86400000
DRIVE_DISCOVERY_LEASE_SECONDS=1800
DRIVE_DISCOVERY_CONTENT_READ_LIMIT=0
DRIVE_DISCOVERY_PERSIST_TRANSCRIPTS=false
DRIVE_DISCOVERY_AUTO_QUEUE=false

# Required only for paid --apply CLI paths. Must identify an active Admin account.
AUTH_ACTOR_EMAIL=

# Bootstrap credentials are intentionally absent. Supply BOOTSTRAP_ADMIN_PASSWORD
# only as a temporary process environment variable; never save it in this file.
