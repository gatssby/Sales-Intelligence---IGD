{
  "name": "sales-intelligence-igd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "demo": "tsx scripts/demo.ts",
    "demo:check": "tsx scripts/demo.ts --check",
    "deploy:production": "bash scripts/deploy-production.sh origin/main",
    "dev": "npm run dev --workspace=@igd/web",
    "build": "npm run build --workspace=@igd/web",
    "test": "npm run test:worker && npm run test --workspaces --if-present",
    "test:worker": "node --import tsx --test scripts/lib/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "db:migrate": "tsx scripts/migrate.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "insider:prepare-sellers": "tsx scripts/prepare-insider-sellers.ts",
    "sellers:import": "tsx scripts/import-sellers.ts",
    "calls:import": "tsx scripts/import-calls.ts",
    "insider:validate": "tsx scripts/validate-insider-dataset.ts",
    "insider:catalog": "tsx scripts/import-insider-catalog.ts",
    "insider:select-queue": "tsx scripts/select-insider-analysis-queue.ts",
    "transcripts:store-stream": "tsx scripts/store-transcript-stream.ts",
    "analysis:process": "tsx scripts/process-analysis-queue.ts",
    "analysis:benchmark": "tsx scripts/run-analysis-benchmark.ts",
    "analysis:report": "tsx scripts/report-official-batch.ts",
    "drive:discover": "tsx scripts/drive-discovery.ts",
    "drive:report": "tsx scripts/report-drive-discovery.ts",
    "drive:sources": "tsx scripts/manage-drive-source.ts",
    "organization:sync": "tsx scripts/organization-sync.ts",
    "auth:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "auth:demo-seed": "tsx scripts/seed-auth-demo.ts",
    "test:auth:http": "tsx scripts/test-auth-http.ts"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "bcryptjs": "^3.0.3",
    "openai": "7.12.1",
    "postgres": "3.4.9",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
